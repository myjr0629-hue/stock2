<?xml version="1.0" encoding="utf-8"?>
<!-- large: 로고 · 티커/이름 · 포지셔닝 바(비트맵) · 가격/등락 — 칸 폭은 WidgetRenderer 의 바 폭 계산과 같다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/row_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="86dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_ticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.015"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_name"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_bar"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_price"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/row_pct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
