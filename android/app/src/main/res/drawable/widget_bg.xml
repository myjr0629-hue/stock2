<?xml version="1.0" encoding="utf-8"?>
<!-- 대시보드 «내 종목» 카드 dSurf 그대로:
     linear #111b2e → #0a1220 · 청 rgba(56,102,180,.24) at 14% 0% · 보라 rgba(88,58,168,.22) at 92% 96%
     · 왼쪽 위 금빛 rgba(251,191,36,.07) · 안쪽 금색 머리카락선 rgba(251,191,36,.10) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:angle="270" android:endColor="#FF0A1220" android:startColor="#FF111B2E" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:centerX="0.14" android:centerY="0" android:endColor="#003866B4" android:gradientRadius="180dp"
                android:startColor="#3D3866B4" android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:centerX="0.92" android:centerY="0.96" android:endColor="#00583AA8" android:gradientRadius="200dp"
                android:startColor="#38583AA8" android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient android:centerX="0" android:centerY="0" android:endColor="#00FBBF24" android:gradientRadius="150dp"
                android:startColor="#12FBBF24" android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1AFBBF24" />
        </shape>
    </item>
</layer-list>
